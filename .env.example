# Copy to `.env.local` and fill in. Nothing here is required to run `npm run
# dev` — every variable degrades to a documented fallback — but production
# wants all of them set.

# Where enquiry forms are delivered. With this unset the submission is logged
# to the server console instead, which `app/actions.ts` treats as fine in
# development and as a hard error in production.
CONTACT_WEBHOOK_URL=

# Shared secret for POST /api/revalidate, the on-demand ISR flush. Unset means
# the endpoint refuses every request. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
REVALIDATE_SECRET=

# Cloudflare sits in front of Vercel on medusaautodetailing.co.uk and caches
# the HTML, so flushing Next's own cache is only half a flush. With both of
# these set, POST /api/revalidate and `npm run purge` purge the zone as well;
# with either unset that half is skipped and says so. The token needs exactly
# one permission: Zone . Cache Purge . Purge, scoped to this zone.
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_API_TOKEN=

# Origin that `npm run verify` crawls (default http://localhost:3000) and that
# `npm run purge` flushes (default https://medusaautodetailing.co.uk - purging
# a local build is not a thing anyone wants to do).
BASE=
