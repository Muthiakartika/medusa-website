# Copy to `.env.local` and fill in. Nothing here is required to run `npm run
# dev` — every variable degrades to a documented fallback — but production
# wants all of them set.

# ── Enquiry forms ────────────────────────────────────────────────────────
# Every form on the site posts to one server action, which emails it through
# SendGrid. The key needs one permission: Mail Send · Full Access. With it
# unset the enquiry is logged to the server console instead, which
# `app/actions.ts` treats as fine in development and as a hard error in
# production.
SENDGRID_API_KEY=

# Who reads the enquiries. Defaults to the address the site publishes,
# info@medusaautodetailing.co.uk, so this only needs setting to change it.
# Comma-separated for more than one.
MAIL_TO=

# Copied in. Comma-separated. Remove this once the client has confirmed the
# forms are arriving — it is here so the build can be watched from outside
# the client's inbox while it is being tested.
MAIL_CC=contact@algoseabiz.com

# The envelope sender, which SendGrid requires to be a verified sender: a
# Single Sender, or any address on a domain authenticated in the SendGrid
# dashboard. Defaults to info@medusaautodetailing.co.uk. It is deliberately
# not the visitor's own address — DMARC exists to stop that — so the visitor
# goes in Reply-To and hitting Reply in the inbox answers them.
MAIL_FROM=
MAIL_FROM_NAME=

# A second, independent sink for the same enquiry: Slack, a sheet, a CRM.
# Optional, and unrelated to the email — both run on every submission and an
# enquiry counts as delivered if either one took it.
CONTACT_WEBHOOK_URL=

# ── Turnstile ────────────────────────────────────────────────────────────
# Cloudflare's challenge, on every enquiry form. Both halves come from the
# same widget in the Cloudflare dashboard (Turnstile → Add widget) and are
# configured together: with the site key unset no widget renders, and with
# the secret unset the server skips the check.
#
# Cloudflare's own dummy keys exercise the real path locally — they must be
# used as a pair, since a production secret rejects a dummy token:
#   NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
#   TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Caching ──────────────────────────────────────────────────────────────
# Shared secret for POST /api/revalidate, the on-demand ISR flush. Unset means
# the endpoint refuses every request. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
REVALIDATE_SECRET=

# Cloudflare sits in front of Vercel on medusaautodetailing.co.uk and caches
# the HTML, so flushing Next's own cache is only half a flush. With both of
# these set, POST /api/revalidate and `npm run purge` purge the zone as well;
# with either unset that half is skipped and says so. The token needs exactly
# one permission: Zone . Cache Purge . Purge, scoped to this zone.
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_API_TOKEN=

# Origin that `npm run verify` crawls (default http://localhost:3000) and that
# `npm run purge` flushes (default https://medusaautodetailing.co.uk - purging
# a local build is not a thing anyone wants to do).
BASE=
