        "SENDGRID_API_KEY": "",
        "CONTACT_WEBHOOK_URL": "",
        "MAIL_TO": "nobody@example.invalid",
        "MAIL_CC": "",
        "TURNSTILE_SECRET_KEY": "",
        "NEXT_PUBLIC_TURNSTILE_SITE_KEY": ""
      }
    },
    {
      "name": "medusa-prod",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["start"],
      "port": 3000
    }
  ]
